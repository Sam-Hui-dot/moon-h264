name = "Sam-Hui-dot/moon-h264"

version = "0.1.0"

license = "Apache-2.0"

readme = "README.md"

repository = "https://github.com/Sam-Hui-dot/moon-h264"

keywords = [ "h264", "avc", "video", "codec", "decoder", "cavlc" ]

description = "Pure-MoonBit ITU-T H.264/AVC Constrained Baseline video decoder, bit-exact FFmpeg-verified YUV420p engine, macroblock/MV inspector, and zero-upload browser player"

preferred_target = "wasm"

import {
  "moonbitlang/async@0.22.4",
}
